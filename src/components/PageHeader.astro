---
// Page hero with emoji, title, subtitle, and an optional read-time badge.
interface Props {
  icon: string;
  title: string;
  subtitle?: string;
  readMinutes?: number;
}
const { icon, title, subtitle, readMinutes } = Astro.props;
---
<header class="mb-8 border-b border-border pb-6">
  <div class="mb-3 flex items-center gap-3">
    <span class="text-4xl leading-none">{icon}</span>
    {
      readMinutes ? (
        <span class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted">
          ⏱ {readMinutes} min read
        </span>
      ) : null
    }
  </div>
  <h1 class="m-0 text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
    {title}
  </h1>
  {
    subtitle ? (
      <p class="mt-3 max-w-[60ch] text-lg leading-relaxed text-muted">
        {subtitle}
      </p>
    ) : null
  }
</header>

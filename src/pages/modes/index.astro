---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Tldr from '../../components/Tldr.astro';
import Callout from '../../components/Callout.astro';
import TryItNow from '../../components/TryItNow.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import CopyPrompt from '../../components/CopyPrompt.astro';

const usecases = (await getCollection('usecases')).sort(
  (a, b) => a.data.order - b.data.order
);

const cardsByMode = {
  chat: usecases.filter((u) => u.data.mode === 'chat'),
  cowork: usecases.filter((u) => u.data.mode === 'cowork'),
  code: usecases.filter((u) => u.data.mode === 'code'),
};

const tabs = [
  { id: 'chat', emoji: '💬', label: 'Chat', accent: 'chat' },
  { id: 'cowork', emoji: '🤝', label: 'Co-Work', accent: 'cowork' },
  { id: 'code', emoji: '⌨️', label: 'Code', accent: 'code' },
  { id: 'compare', emoji: '⚖️', label: 'Compare', accent: 'gold' },
];

const roles = [
  { id: 'all', emoji: '🌐', label: 'All Teams' },
  { id: 'finance', emoji: '💰', label: 'Finance' },
  { id: 'marketing', emoji: '📣', label: 'Marketing' },
  { id: 'engineering', emoji: '⚙️', label: 'Software Engineering' },
  { id: 'manufacturing', emoji: '🏭', label: 'Manufacturing' },
  { id: 'cad', emoji: '📐', label: 'CAD / CATIA' },
];

const badge: Record<string, string> = {
  general: 'text-gold border-gold/30 bg-gold/10',
  finance: 'text-[#34D399] border-[#34D399]/30 bg-[#34D399]/10',
  marketing: 'text-[#F472B6] border-[#F472B6]/30 bg-[#F472B6]/10',
  engineering: 'text-[#60A5FA] border-[#60A5FA]/30 bg-[#60A5FA]/10',
  manufacturing: 'text-[#FB923C] border-[#FB923C]/30 bg-[#FB923C]/10',
  cad: 'text-[#A78BFA] border-[#A78BFA]/30 bg-[#A78BFA]/10',
};
const badgeLabel: Record<string, string> = {
  general: '✦ All Teams',
  finance: 'Finance',
  marketing: 'Marketing',
  engineering: 'Engineering',
  manufacturing: 'Manufacturing',
  cad: 'CAD / CATIA',
};

const accentText: Record<string, string> = {
  chat: 'text-chat',
  cowork: 'text-cowork',
  code: 'text-code',
};
const accentBorderSel: Record<string, string> = {
  chat: 'data-[selected=true]:border-chat data-[selected=true]:text-chat',
  cowork: 'data-[selected=true]:border-cowork data-[selected=true]:text-cowork',
  code: 'data-[selected=true]:border-code data-[selected=true]:text-code',
  gold: 'data-[selected=true]:border-gold data-[selected=true]:text-gold',
};
---

<BaseLayout
  title="The Three Modes"
  description="Chat, Cowork, and Code — what each one is and when to reach for it. Browse 50+ Aptera use cases by team."
  pageId="modes"
  readMinutes={9}
>
  <PageHeader
    icon="⚡"
    title="The Three Modes"
    subtitle="Chat is where you talk. Co-Work is where you delegate. Code is where you automate. Same Claude, three very different gears."
    readMinutes={9}
  />

  <Tldr>
    <p>
      Claude shows up in three flavors. <strong class="text-chat">Chat</strong> is a
      conversation — ask, draft, think out loud, no setup. <strong class="text-cowork"
        >Co-Work</strong
      > hands Claude the keys to your real tools (Jira, Confluence, Ramp) so it
      <em>does</em> the multi-step task instead of advising you on it.
      <strong class="text-code">Code</strong> lives in the terminal with access to your
      files, servers, and APIs — it builds and runs the automation. Rule of thumb:
      <strong>talk → Chat, delegate → Co-Work, automate → Code.</strong>
    </p>
  </Tldr>

  <!-- ───────────── MINI QUIZ ───────────── -->
  <section class="my-8 rounded-[12px] border border-border bg-card">
    <button
      type="button"
      id="quiz-toggle"
      aria-expanded="true"
      aria-controls="quiz-body"
      class="flex w-full items-center justify-between gap-3 px-5 py-4 text-left"
    >
      <span class="flex items-center gap-2 font-bold text-text"> 🧭 Which mode do I need? </span>
      <span id="quiz-chevron" class="text-muted transition-transform">▾</span>
    </button>

    <div id="quiz-body" class="border-t border-border px-5 py-5">
      <p class="mb-4 mt-0 text-sm text-muted">
        Three quick questions. No wrong answers — just a nudge toward the right gear.
        <button id="quiz-skip" type="button" class="ml-1 text-gold underline underline-offset-2"
          >Skip it</button
        >.
      </p>

      <form id="quiz-form" class="space-y-5">
        <fieldset>
          <legend class="mb-2 font-semibold text-text">1. What do you actually want to happen?</legend>
          <div class="flex flex-col gap-2">
            <label class="quiz-opt"
              ><input type="radio" name="q1" value="chat" /> <span
                >Just get an answer or a draft back from me</span
              ></label
            >
            <label class="quiz-opt"
              ><input type="radio" name="q1" value="cowork" /> <span
                >Have something actually done in Jira / Confluence / Ramp</span
              ></label
            >
            <label class="quiz-opt"
              ><input type="radio" name="q1" value="code" /> <span
                >Build a script or automation that runs again and again</span
              ></label
            >
          </div>
        </fieldset>

        <fieldset>
          <legend class="mb-2 font-semibold text-text"
            >2. Should Claude touch your tools or files directly?</legend
          >
          <div class="flex flex-col gap-2">
            <label class="quiz-opt"
              ><input type="radio" name="q2" value="chat" /> <span
                >No — I'll copy/paste what I need</span
              ></label
            >
            <label class="quiz-opt"
              ><input type="radio" name="q2" value="cowork" /> <span
                >Yes — connected apps like Jira, Confluence, Ramp</span
              ></label
            >
            <label class="quiz-opt"
              ><input type="radio" name="q2" value="code" /> <span
                >Yes — my codebase, servers, the terminal, local files</span
              ></label
            >
          </div>
        </fieldset>

        <fieldset>
          <legend class="mb-2 font-semibold text-text">3. How comfortable are you in a terminal?</legend>
          <div class="flex flex-col gap-2">
            <label class="quiz-opt"
              ><input type="radio" name="q3" value="chat" /> <span
                >I'd rather just chat in a browser</span
              ></label
            >
            <label class="quiz-opt"
              ><input type="radio" name="q3" value="cowork" /> <span
                >Happy with apps, not a command line</span
              ></label
            >
            <label class="quiz-opt"
              ><input type="radio" name="q3" value="code" /> <span
                >Comfortable — I live in the terminal</span
              ></label
            >
          </div>
        </fieldset>
      </form>

      <div
        id="quiz-result"
        class="mt-5 hidden rounded-[10px] border border-gold/40 bg-gold/5 px-4 py-3 text-text"
        role="status"
        aria-live="polite"
      >
        <p id="quiz-result-text" class="m-0"></p>
        <button
          id="quiz-jump"
          type="button"
          class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-gold/60 bg-gold/10 px-3 py-1.5 text-sm font-semibold text-gold transition-colors hover:bg-gold/20"
        >
          Take me there →
        </button>
      </div>
    </div>
  </section>

  <!-- ───────────── TAB BAR (sticky) ───────────── -->
  <div
    id="tabbar"
    class="sticky top-0 z-30 -mx-5 mb-6 border-b border-border bg-canvas/95 px-5 py-3 backdrop-blur sm:-mx-8 sm:px-8 lg:-mx-12 lg:px-12"
  >
    <div role="tablist" aria-label="Claude modes" class="flex flex-wrap gap-2">
      {
        tabs.map((t) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            data-tab={t.id}
            aria-controls={`panel-${t.id}`}
            aria-selected={t.id === 'chat' ? 'true' : 'false'}
            data-selected={t.id === 'chat' ? 'true' : 'false'}
            class:list={[
              'tab-btn flex items-center gap-2 rounded-full border-[1.5px] border-border px-4 py-2 text-sm font-medium text-muted transition-colors hover:border-gold/50 hover:text-text',
              accentBorderSel[t.accent],
            ]}
          >
            <span>{t.emoji}</span>
            <span>{t.label}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- ───────────── MODE PANELS ───────────── -->
  {
    (['chat', 'cowork', 'code'] as const).map((mode) => (
      <section
        id={`panel-${mode}`}
        role="tabpanel"
        aria-labelledby={`tab-${mode}`}
        class:list={['mode-panel', mode === 'chat' ? '' : 'hidden']}
        data-panel={mode}
      >
        {mode === 'chat' && (
          <div class="mb-5">
            <h2 class="mb-2 mt-0 text-2xl font-bold text-chat">💬 Claude Chat</h2>
            <p class="m-0 leading-relaxed text-muted">
              The conversational layer, and where most people start — for good reason. No
              setup, no configuration, just a conversation. Ask questions, think out loud,
              draft things, and get instant feedback. The right tool for anything that
              starts with "can you help me…"
            </p>
          </div>
        )}
        {mode === 'cowork' && (
          <div class="mb-5">
            <h2 class="mb-2 mt-0 text-2xl font-bold text-cowork">🤝 Claude Co-Work</h2>
            <p class="m-0 leading-relaxed text-muted">
              Where Claude stops advising and starts doing. It connects to your real tools
              — Jira, Confluence, Ramp, and more — and takes multi-step actions on your
              behalf. Drop in a transcript and it writes the minutes and files the tickets.
              It also has limited access to your file system: it can save files straight to
              a folder you grant it.
            </p>
          </div>
        )}
        {mode === 'code' && (
          <div class="mb-5">
            <h2 class="mb-2 mt-0 text-2xl font-bold text-code">⌨️ Claude Code</h2>
            <p class="m-0 leading-relaxed text-muted">
              For technical work that lives in the terminal. Full access to your codebase,
              file system, and infrastructure. It SSHes into servers, writes and runs
              scripts, refactors code with tests, and connects to tools like GitHub and
              Confluence — operating the way a skilled developer or sysadmin would, not just
              suggesting what one might do.
            </p>
          </div>
        )}

        {mode === 'chat' && (
          <Callout variant="chat" title="✨ Artifacts">
            <p>
              When Claude produces something tangible — a document, a spreadsheet, a block of
              code, a formatted report — it appears as an <strong>Artifact</strong>: a live,
              copyable output sitting alongside the conversation that you can use, download,
              or hand off directly.
            </p>
          </Callout>
        )}
        {mode === 'cowork' && (
          <>
            <Callout variant="cowork" title="🗓️ Schedules">
              <p>
                Tell Claude to run a task automatically on a recurring basis — pull a report
                every Monday, post a status every Friday, email a summary at month-end. Set
                it once and it runs without you, <strong>
                  as long as your computer is on and the Claude desktop app is running.
                </strong>
              </p>
            </Callout>
            <Callout variant="cowork" title="📁 Projects">
              <p>
                Persistent workspaces where Claude remembers context between sessions. Set up
                a Project for an initiative or team and Claude carries the background into
                every conversation — no re-explaining who you are or what you're working on.
              </p>
            </Callout>
            <Callout variant="cowork" title="🔌 Many tools connect to Co-Work">
              <p>
                Jira, Confluence, and Ramp are just the ones we have today. The platform also
                supports NetSuite, Google Workspace, Slack, and many others — plus limited
                local file-system access. If you want a tool connected, ask.
              </p>
            </Callout>
          </>
        )}
        {mode === 'code' && (
          <>
            <Callout variant="code" title="🔁 Routines">
              <p>
                Scheduled automations that run in the background on a defined cadence — a
                morning server health check, a weekly data pipeline, a nightly log rollup.
                Define it once and Claude Code handles it on schedule. <strong>
                  Routines require your computer to be on and the Claude app to be running
                </strong> — they're local automations, not cloud-hosted jobs.
              </p>
            </Callout>
            <Callout variant="code" title="🔗 It connects to tools too">
              <p>
                The terminal is home base, but it's not the limit. Claude Code reads and
                writes Confluence, pushes commits and opens PRs on GitHub, creates Jira
                tickets, and calls external APIs. If you can describe it in a sentence, it can
                usually do it end-to-end.
              </p>
            </Callout>
          </>
        )}

        {/* Role pills + count + view toggle */}
        <div class="mb-4 mt-6 flex flex-col gap-3">
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by team">
            {roles.map((r) => (
              <button
                type="button"
                data-role={r.id}
                aria-pressed={r.id === 'all' ? 'true' : 'false'}
                class="role-pill flex items-center gap-1.5 rounded-full border-[1.5px] border-border px-3 py-1.5 text-sm font-medium text-muted transition-colors hover:border-gold/50 hover:text-text aria-pressed:border-gold aria-pressed:bg-gold/10 aria-pressed:text-gold"
              >
                <span>{r.emoji}</span>
                <span>{r.label}</span>
              </button>
            ))}
          </div>

          <div class="flex items-center justify-between gap-3">
            <p class="m-0 text-sm text-dim" data-count={mode} />
            <div class="flex items-center gap-1 rounded-full border border-border bg-card p-1">
              <button
                type="button"
                data-view="tile"
                aria-pressed="true"
                class="view-btn rounded-full px-3 py-1 text-xs font-medium text-muted transition-colors aria-pressed:bg-card-hover aria-pressed:text-gold"
              >
                ▦ Tiles
              </button>
              <button
                type="button"
                data-view="list"
                aria-pressed="false"
                class="view-btn rounded-full px-3 py-1 text-xs font-medium text-muted transition-colors aria-pressed:bg-card-hover aria-pressed:text-gold"
              >
                ☰ List
              </button>
            </div>
          </div>
        </div>

        {/* Card area */}
        <div class="card-area grid gap-4 sm:grid-cols-2" data-mode={mode} data-view="tile">
          {cardsByMode[mode].map((u) => (
            <article
              class="uc-card group cursor-pointer rounded-[12px] border border-border bg-card p-5 transition-colors hover:border-gold/40 hover:bg-card-hover"
              data-role={u.data.role}
              data-mode={mode}
            >
              <button type="button" class="uc-trigger flex w-full items-start gap-3 text-left" aria-expanded="false">
                <span class="uc-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] bg-card-hover text-xl">
                  {u.data.icon}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="uc-title block font-semibold leading-snug text-text">{u.data.title}</span>
                  <span class="uc-blurb mt-1 block text-sm leading-relaxed text-muted">{u.data.blurb}</span>
                  <span class="mt-3 flex items-center justify-between gap-2">
                    <span
                      class:list={[
                        'inline-flex w-fit items-center rounded-full border px-2.5 py-0.5 text-[0.68rem] font-semibold uppercase tracking-wide',
                        badge[u.data.role],
                      ]}
                    >
                      {badgeLabel[u.data.role]}
                    </span>
                    <span class="uc-hint text-xs text-dim group-hover:text-muted">↓ more</span>
                  </span>
                </span>
              </button>

              <div class="uc-detail hidden">
                <div class="mt-4 border-t border-border pt-4">
                  <p class="m-0 leading-relaxed text-muted">{u.data.detail}</p>
                  <div class="mt-3">
                    <p
                      class:list={[
                        'm-0 mb-1 text-[0.65rem] font-bold uppercase tracking-widest',
                        accentText[mode],
                      ]}
                    >
                      Try saying →
                    </p>
                    <CopyPrompt text={u.data.prompt} />
                  </div>
                  <button
                    type="button"
                    class="uc-close rounded-full border border-border px-3 py-1 text-xs text-dim transition-colors hover:border-muted hover:text-text"
                  >
                    ✕ Close
                  </button>
                </div>
              </div>
            </article>
          ))}
          <p class="uc-empty col-span-full hidden py-10 text-center text-sm text-dim">
            No cards match this filter. Try "All Teams" to see general use cases.
          </p>
        </div>
      </section>
    ))
  }

  <!-- ───────────── COMPARE PANEL ───────────── -->
  <section
    id="panel-compare"
    role="tabpanel"
    aria-labelledby="tab-compare"
    class="mode-panel hidden"
    data-panel="compare"
  >
    <div class="mb-5">
      <h2 class="mb-2 mt-0 text-2xl font-bold text-gold">⚖️ Which mode should I use?</h2>
      <p class="m-0 leading-relaxed text-muted">Quick reference for when each mode makes sense.</p>
    </div>

    <div class="overflow-x-auto rounded-[12px] border border-border">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="px-4 py-3 font-medium text-muted">Question</th>
            <th class="px-4 py-3 font-bold text-chat">💬 Chat</th>
            <th class="px-4 py-3 font-bold text-cowork">🤝 Co-Work</th>
            <th class="px-4 py-3 font-bold text-code">⌨️ Code</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0 [&_tr]:border-b [&_tr]:border-border">
          <tr>
            <td class="px-4 py-3 font-medium text-text">Where does it run?</td>
            <td class="px-4 py-3 text-muted">Browser / mobile app</td>
            <td class="px-4 py-3 text-muted">Browser + connected tools</td>
            <td class="px-4 py-3 text-muted">Your terminal / IDE</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-text">Who drives the work?</td>
            <td class="px-4 py-3 text-muted">You, always</td>
            <td class="px-4 py-3 text-muted">Claude, supervised by you</td>
            <td class="px-4 py-3 text-muted">Claude, with your guidance</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-text">Can it write to external tools?</td>
            <td class="px-4 py-3 text-muted">No</td>
            <td class="px-4 py-3 text-muted">Yes — Jira, Confluence, Ramp, etc.</td>
            <td class="px-4 py-3 text-muted">Yes — files, APIs, servers</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-text">Does it need tech setup?</td>
            <td class="px-4 py-3 text-muted">Just a browser login</td>
            <td class="px-4 py-3 text-muted">Plugin connections (one-time)</td>
            <td class="px-4 py-3 text-muted">CLI install + terminal access</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-text">Best for…</td>
            <td class="px-4 py-3 text-muted">Quick questions, drafts, thinking out loud</td>
            <td class="px-4 py-3 text-muted">Multi-step doc / project tasks</td>
            <td class="px-4 py-3 text-muted">Automations, dev work, ops tasks</td>
          </tr>
          <tr>
            <td class="px-4 py-3 font-medium text-text">Technical skill required?</td>
            <td class="px-4 py-3 text-muted">None</td>
            <td class="px-4 py-3 text-muted">None (IT sets up tools)</td>
            <td class="px-4 py-3 text-muted">Comfortable in a terminal</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <TryItNow title="Try one today">
    <p>
      Pick your team's tab above, find a card that matches something on your plate this
      week, and run the prompt. Don't overthink it — the fastest way to learn the modes is
      to use one. Here's a no-excuses starter:
    </p>
    <CopyPrompt
      text="I have a recurring task that eats time every week. Here's what it involves: [describe it]. Which Claude mode fits best — Chat, Co-Work, or Code — and what's the very first thing I should try?"
    />
  </TryItNow>

  <KeyTakeaways>
    <ul>
      <li><strong>Talk → Chat, delegate → Co-Work, automate → Code.</strong> If you only remember one thing, remember that.</li>
      <li>Co-Work and Code can act on your real tools and files — Chat just talks. Reach for the higher gear when you want something <em>done</em>, not just answered.</li>
      <li>Schedules and Routines only run while your computer is on and the Claude app is open — they're local helpers, not cloud jobs.</li>
    </ul>
  </KeyTakeaways>
</BaseLayout>

<style>
  .quiz-opt {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    cursor: pointer;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    padding: 0.6rem 0.85rem;
    line-height: 1.45;
    color: var(--color-text);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .quiz-opt:hover {
    border-color: color-mix(in srgb, var(--color-gold) 50%, transparent);
  }
  .quiz-opt input {
    margin-top: 0.25rem;
    accent-color: var(--color-gold);
  }
  .quiz-opt:has(input:checked) {
    border-color: var(--color-gold);
    background: color-mix(in srgb, var(--color-gold) 8%, transparent);
  }

  /* List view: collapse the card grid into single-column compact rows */
  .card-area[data-view='list'] {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .card-area[data-view='list'] .uc-card {
    padding: 0.75rem 1rem;
  }
  .card-area[data-view='list'] .uc-blurb {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-area[data-view='list'] .uc-icon {
    height: 2rem;
    width: 2rem;
    font-size: 1rem;
  }
</style>

<script>
  // ───────────── Tab + role + view state, URL-synced ─────────────
  const VIEW_KEY = 'aptera-ai-viewmode';
  const validTabs = ['chat', 'cowork', 'code', 'compare'];
  const validRoles = ['all', 'finance', 'marketing', 'engineering', 'manufacturing', 'cad'];

  const tabBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.mode-panel'));

  function getParams() {
    return new URLSearchParams(window.location.search);
  }
  function writeParams(params: URLSearchParams) {
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
  }

  // ---- Tabs ----
  function activateTab(tab: string, push = true) {
    if (!validTabs.includes(tab)) tab = 'chat';
    tabBtns.forEach((btn) => {
      const sel = btn.dataset.tab === tab;
      btn.setAttribute('aria-selected', sel ? 'true' : 'false');
      btn.dataset.selected = sel ? 'true' : 'false';
    });
    panels.forEach((p) => {
      p.classList.toggle('hidden', p.dataset.panel !== tab);
    });
    if (push) {
      const params = getParams();
      params.set('mode', tab);
      writeParams(params);
    }
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => activateTab(btn.dataset.tab!));
  });

  // ---- Role filter (shared across all mode panels) ----
  let currentRole = 'all';

  function applyFilter() {
    document.querySelectorAll<HTMLElement>('.card-area').forEach((area) => {
      const cards = Array.from(area.querySelectorAll<HTMLElement>('.uc-card'));
      let visible = 0;
      cards.forEach((card) => {
        const role = card.dataset.role!;
        const show = currentRole === 'all' || role === 'general' || role === currentRole;
        card.classList.toggle('hidden', !show);
        if (show) {
          visible++;
        } else {
          card.querySelector('.uc-detail')?.classList.add('hidden');
          card.querySelector('.uc-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
      const mode = area.dataset.mode!;
      const countEl = document.querySelector<HTMLElement>(`[data-count="${mode}"]`);
      if (countEl) countEl.textContent = `${visible} use case${visible !== 1 ? 's' : ''} shown`;
      const empty = area.querySelector<HTMLElement>('.uc-empty');
      if (empty) empty.classList.toggle('hidden', visible !== 0);
    });
  }

  function setRole(role: string, push = true) {
    if (!validRoles.includes(role)) role = 'all';
    currentRole = role;
    document.querySelectorAll<HTMLButtonElement>('.role-pill').forEach((pill) => {
      pill.setAttribute('aria-pressed', pill.dataset.role === role ? 'true' : 'false');
    });
    applyFilter();
    if (push) {
      const params = getParams();
      if (role === 'all') params.delete('role');
      else params.set('role', role);
      writeParams(params);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.role-pill').forEach((pill) => {
    pill.addEventListener('click', () => setRole(pill.dataset.role!));
  });

  // ---- View toggle (tile / list), persisted ----
  function setView(view: string, persist = true) {
    if (view !== 'tile' && view !== 'list') view = 'tile';
    document.querySelectorAll<HTMLElement>('.card-area').forEach((area) => {
      area.dataset.view = view;
    });
    document.querySelectorAll<HTMLButtonElement>('.view-btn').forEach((btn) => {
      btn.setAttribute('aria-pressed', btn.dataset.view === view ? 'true' : 'false');
    });
    if (persist) {
      try {
        localStorage.setItem(VIEW_KEY, view);
      } catch {
        /* ignore */
      }
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.view-btn').forEach((btn) => {
    btn.addEventListener('click', () => setView(btn.dataset.view!));
  });

  // ---- Card expand / collapse ----
  document.querySelectorAll<HTMLElement>('.uc-card').forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>('.uc-trigger');
    const detail = card.querySelector<HTMLElement>('.uc-detail');
    const closeBtn = card.querySelector<HTMLButtonElement>('.uc-close');

    trigger?.addEventListener('click', () => {
      const isOpen = !detail?.classList.contains('hidden');
      if (isOpen) {
        detail?.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        detail?.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      detail?.classList.add('hidden');
      trigger?.setAttribute('aria-expanded', 'false');
    });
  });

  // ───────────── Mini-quiz ─────────────
  const quizToggle = document.getElementById('quiz-toggle');
  const quizBody = document.getElementById('quiz-body');
  const quizChevron = document.getElementById('quiz-chevron');
  const quizForm = document.getElementById('quiz-form') as HTMLFormElement | null;
  const quizResult = document.getElementById('quiz-result');
  const quizResultText = document.getElementById('quiz-result-text');
  const quizJump = document.getElementById('quiz-jump');
  const quizSkip = document.getElementById('quiz-skip');

  function collapseQuiz() {
    quizBody?.classList.add('hidden');
    quizToggle?.setAttribute('aria-expanded', 'false');
    if (quizChevron) quizChevron.style.transform = 'rotate(-90deg)';
  }
  function expandQuiz() {
    quizBody?.classList.remove('hidden');
    quizToggle?.setAttribute('aria-expanded', 'true');
    if (quizChevron) quizChevron.style.transform = '';
  }

  quizToggle?.addEventListener('click', () => {
    if (quizBody?.classList.contains('hidden')) expandQuiz();
    else collapseQuiz();
  });
  quizSkip?.addEventListener('click', (e) => {
    e.preventDefault();
    collapseQuiz();
  });

  const quizCopy: Record<string, { label: string; emoji: string; why: string }> = {
    chat: {
      label: 'Chat',
      emoji: '💬',
      why: "You mostly want answers and drafts you'll act on yourself. Start in Chat — no setup, instant feedback.",
    },
    cowork: {
      label: 'Co-Work',
      emoji: '🤝',
      why: "You want Claude to actually do multi-step work in your connected tools like Jira, Confluence, and Ramp. That's Co-Work.",
    },
    code: {
      label: 'Code',
      emoji: '⌨️',
      why: "You're building automations and you're comfortable near a terminal and your files. Claude Code is your gear.",
    },
  };

  function scoreQuiz() {
    if (!quizForm) return;
    const data = new FormData(quizForm);
    const answers = ['q1', 'q2', 'q3']
      .map((q) => data.get(q) as string | null)
      .filter(Boolean) as string[];
    if (answers.length < 3) return;

    const tally: Record<string, number> = { chat: 0, cowork: 0, code: 0 };
    answers.forEach((a) => {
      if (a in tally) tally[a]++;
    });
    const q1 = data.get('q1') as string | null;
    if (q1 && q1 in tally) tally[q1] += 0.5;

    let winner = 'chat';
    let best = -1;
    for (const k of ['chat', 'cowork', 'code']) {
      if (tally[k] > best) {
        best = tally[k];
        winner = k;
      }
    }

    const c = quizCopy[winner];
    if (quizResultText) {
      quizResultText.innerHTML = `<strong>${c.emoji} ${c.label}</strong> is your best fit. ${c.why}`;
    }
    quizResult?.classList.remove('hidden');
    quizJump?.setAttribute('data-target', winner);
  }

  quizForm?.addEventListener('change', scoreQuiz);

  quizJump?.addEventListener('click', () => {
    const target = quizJump.getAttribute('data-target') || 'chat';
    activateTab(target);
    collapseQuiz();
    document.getElementById('tabbar')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ───────────── Init from URL + localStorage ─────────────
  (function init() {
    const params = getParams();
    const tab = params.get('mode') || 'chat';
    const role = params.get('role') || 'all';
    let view = 'tile';
    try {
      view = localStorage.getItem(VIEW_KEY) || 'tile';
    } catch {
      /* ignore */
    }
    setView(view, false);
    setRole(role, false);
    activateTab(tab, false);
  })();
</script>

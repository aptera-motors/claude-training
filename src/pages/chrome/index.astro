---
// Redirect stub — this site moved to the Aptera AI Academy app.
const target = "https://ai-training.apteraops.com/tracks/claude/browser";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={"1; url=" + target} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
    <title>Aptera AI Academy has moved</title>
    <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
    <style>
      body { font-family: system-ui, sans-serif; background: #121413; color: #e7e9e7;
             display: grid; place-items: center; min-height: 100vh; margin: 0; text-align: center; }
      a { color: #8dc73f; font-weight: 700; }
      .mark { width: 14px; height: 14px; background: #8dc73f; transform: rotate(45deg);
              display: inline-block; margin-bottom: 1rem; }
    </style>
  </head>
  <body>
    <main>
      <span class="mark"></span>
      <h1>We moved.</h1>
      <p>The Aptera AI Academy now lives at its new home — sign in with your Rippling account.</p>
      <p><a href={target}>Continue to the new AI Academy &rarr;</a></p>
    </main>
  </body>
</html>

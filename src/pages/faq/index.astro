---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Tldr from '../../components/Tldr.astro';
import { getCollection, render } from 'astro:content';

const faqItems = await getCollection('faq');
// Sort by order field in frontmatter
const sorted = faqItems.sort((a, b) => a.data.order - b.data.order);
const entries = await Promise.all(
  sorted.map(async (item) => ({ item, Content: (await render(item)).Content }))
);
---
<BaseLayout
  title="FAQ"
  description="The questions everyone asks, answered."
  pageId="faq"
  readMinutes={4}
>
  <PageHeader
    icon="❓"
    title="FAQ"
    subtitle="The questions everyone asks, answered."
    readMinutes={4}
  />

  <Tldr>
    <p>
      Can't find an answer? Reach out to Jake at jake@aptera.us.
    </p>
  </Tldr>

  <div class="space-y-3 reveal">
    {
      entries.map(({ item, Content }) => (
        <details class="rounded-xl border border-border bg-card p-4 transition-colors hover:border-gold/50 hover:bg-card-hover">
          <summary class="cursor-pointer font-semibold text-text hover:text-gold">
            {item.data.question}
          </summary>
          <div class="prose-content mt-4 text-muted [&_p]:m-0 [&_p+p]:mt-2 [&_a]:text-gold [&_a]:underline">
            <Content />
          </div>
        </details>
      ))
    }
  </div>
</BaseLayout>

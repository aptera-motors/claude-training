---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tldr from '../components/Tldr.astro';
import Quote from '../components/Quote.astro';
import { NAV_GROUPS, PAGE_ORDER, href, TOTAL_PAGES, TOTAL_MINUTES, PROGRESS_KEY } from '../lib/site';

// First three "START HERE" pages drive the step cards.
const steps = [
  PAGE_ORDER.find((p) => p.id === 'getting-started')!,
  PAGE_ORDER.find((p) => p.id === 'modes')!,
  PAGE_ORDER.find((p) => p.id === 'prompting')!,
];
// All pages except Home for the big grid.
const allPages = PAGE_ORDER.filter((p) => p.id !== 'home');

// Total training time, formatted as "1 hr 41 min".
const totalHours = Math.floor(TOTAL_MINUTES / 60);
const totalMinsRemainder = TOTAL_MINUTES % 60;
const totalTimeLabel =
  totalHours > 0
    ? `${totalHours} hr ${totalMinsRemainder} min`
    : `${totalMinsRemainder} min`;

// Minimal {id, readMinutes} pairs for the client-side progress script.
const pageMinutes = PAGE_ORDER.map((p) => ({ id: p.id, readMinutes: p.readMinutes }));

// "Start here for your role" pills.
const roles = [
  { key: 'finance', label: 'Finance', emoji: '💰' },
  { key: 'marketing', label: 'Marketing', emoji: '📣' },
  { key: 'engineering', label: 'Engineering', emoji: '🛠️' },
  { key: 'manufacturing', label: 'Manufacturing', emoji: '🏭' },
  { key: 'cad', label: 'CAD', emoji: '📐' },
];
---
<BaseLayout
  title="Home"
  description="Aptera AI Academy — level up with Claude. Internal AI training for every team at Aptera Motors."
  pageId="home"
>
  <!-- Hero -->
  <section class="mb-12">
    <p class="mb-3 text-sm font-bold uppercase tracking-widest text-gold">
      Aptera AI Academy
    </p>
    <h1 class="m-0 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
      Get really, really good at
      <span class="text-gold">working with Claude.</span>
    </h1>
    <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-muted">
      This is your home base for using AI at Aptera. No PhD required — just
      practical skills that hand the boring stuff to a robot so you can do the
      work only you can do.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a
        href={href('/getting-started/')}
        class="rounded-[12px] bg-gold px-5 py-2.5 font-semibold text-canvas transition-opacity hover:opacity-90"
      >
        Start training →
      </a>
      <a
        href={href('/modes/')}
        class="rounded-[12px] border border-border bg-card px-5 py-2.5 font-semibold text-text transition-colors hover:border-gold/50 hover:bg-card-hover"
      >
        Explore the three modes
      </a>
      <span class="text-sm font-semibold text-muted">
        ⏱ ≈ {totalTimeLabel} of bite-sized lessons
      </span>
    </div>
  </section>

  <Quote attribution="Andrew Ng" source="founder of DeepLearning.AI & Coursera">
    "AI is the new electricity! Electricity transformed countless industries; AI will now do the same."
  </Quote>

  <Tldr>
    <p>
      Aptera gave every team access to Claude. This site teaches you the
      <strong>three ways to use it</strong>, how to <strong>write prompts that
      work</strong>, and what's <strong>safe to share</strong> — in bite-sized,
      skimmable pages. Start at Getting Started and click Next at the bottom of
      each page.
    </p>
  </Tldr>

  <!-- Start your training -->
  <section class="reveal mb-14">
    <h2 class="mb-5 text-2xl font-bold tracking-tight">Start your training</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        steps.map((step, i) => (
          <a
            href={href(step.href)}
            class="group hover-lift rounded-[12px] border border-border bg-card p-5 transition-colors hover:border-gold/50 hover:bg-card-hover"
          >
            <div class="mb-3 flex items-center justify-between">
              <span class="text-3xl">{step.emoji}</span>
              <span class="text-sm font-bold text-dim">Step {i + 1}</span>
            </div>
            <h3 class="m-0 font-bold text-text group-hover:text-gold">
              {step.label}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{step.blurb}</p>
          </a>
        ))
      }
    </div>

    <!-- Start here for your role -->
    <div class="mt-8">
      <p class="mb-3 text-sm text-muted">Or start here for your role:</p>
      <div class="flex flex-wrap gap-2">
        {
          roles.map((role) => (
            <a
              href={`${href('/modes/')}?role=${role.key}`}
              class="hover-lift inline-flex items-center gap-1.5 rounded-full border border-gold/30 bg-gold/10 px-3.5 py-1.5 text-sm font-semibold text-gold transition-colors hover:bg-gold/20"
            >
              <span aria-hidden="true">{role.emoji}</span>
              {role.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Everything on this site -->
  <section class="reveal mb-14">
    <h2 class="mb-5 text-2xl font-bold tracking-tight">Everything on this site</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        allPages.map((page) => (
          <a
            href={href(page.href)}
            class="group hover-lift flex items-start gap-3 rounded-[12px] border border-border bg-card p-4 transition-colors hover:border-gold/50 hover:bg-card-hover"
          >
            <span class="text-2xl leading-none">{page.emoji}</span>
            <span class="min-w-0">
              <span class="block font-semibold text-text group-hover:text-gold">
                {page.label}
              </span>
              <span class="block text-sm leading-snug text-muted">{page.blurb}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Progress widget -->
  <section class="reveal mb-14">
    <div id="progress-widget" class="rounded-[12px] border border-gold/40 bg-gold/5 p-6">
      <!-- In-progress state (default markup; swapped out by script on completion) -->
      <div id="progress-in-progress">
        <h2 class="m-0 text-xl font-bold tracking-tight">Your progress</h2>
        <p class="mt-2 text-muted">
          You've visited
          <span id="progress-count" class="font-bold text-gold">0</span>
          of {TOTAL_PAGES} pages.
          <span id="progress-time-left"></span>
        </p>
        <div class="mt-4 h-2.5 w-full overflow-hidden rounded-full bg-card">
          <div id="progress-bar" class="bar-animate h-full rounded-full bg-gold" style="width: 0%"></div>
        </div>
      </div>

      <!-- Completion state (hidden by default; shown by script) -->
      <div id="progress-complete" class="hidden">
        <div class="flex items-center gap-2">
          <span class="text-2xl" aria-hidden="true">🎉</span>
          <h2 class="m-0 text-xl font-bold tracking-tight">You've completed the Academy</h2>
        </div>
        <p class="mt-2 text-muted">
          Nice work — you've been through all {TOTAL_PAGES} pages. Here's what's next:
        </p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <a href={href('/wins/')} class="hover-lift rounded-[12px] border border-border bg-card px-4 py-2 font-semibold text-text transition-colors hover:border-gold/50 hover:bg-card-hover">
            🏆 See the Win Gallery
          </a>
          <a href="mailto:jake@aptera.us?subject=My%20AI%20win" class="hover-lift rounded-[12px] border border-border bg-card px-4 py-2 font-semibold text-text transition-colors hover:border-gold/50 hover:bg-card-hover">
            ✉️ Share a win with Jake
          </a>
          <a href={href('/glossary/')} class="hover-lift rounded-[12px] border border-border bg-card px-4 py-2 font-semibold text-text transition-colors hover:border-gold/50 hover:bg-card-hover">
            📖 Revisit the Glossary
          </a>
          <a href={href('/faq/')} class="hover-lift rounded-[12px] border border-border bg-card px-4 py-2 font-semibold text-text transition-colors hover:border-gold/50 hover:bg-card-hover">
            ❓ Revisit the FAQ
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why AI at Aptera -->
  <section class="reveal mb-6">
    <h2 class="mb-3 text-2xl font-bold tracking-tight">Why AI at Aptera?</h2>
    <div class="prose-content text-muted">
      <p>
        We're building a car that runs on sunlight. That's hard enough without
        spending half your week wrestling spreadsheets, summarizing threads, or
        formatting docs. So we put Claude in everyone's toolbox — not to replace
        anyone, but to clear the runway. Hand off the tedious stuff, keep the
        interesting stuff, and ship the future a little faster. Class is in
        session.
      </p>
    </div>
  </section>

  <!-- Closing note -->
  <div class="reveal">
    <Quote attribution="Ethan Mollick" source="Co-Intelligence: Living and Working with AI" variant="boxed">
      "Assume this is the worst AI you'll ever use."
    </Quote>
  </div>

  <script is:inline define:vars={{ total: TOTAL_PAGES, progressKey: PROGRESS_KEY, pageMinutes }}>
    // Render the progress widget. Runs on DOMContentLoaded so the layout's
    // tracking script (later in the body) has already recorded this visit.
    function render() {
      let visited = [];
      try {
        const arr = JSON.parse(localStorage.getItem(progressKey) || '[]');
        if (Array.isArray(arr)) visited = arr;
      } catch {
        /* ignore */
      }
      const count = visited.length;

      const inProgressEl = document.getElementById('progress-in-progress');
      const completeEl = document.getElementById('progress-complete');

      if (count >= total) {
        if (inProgressEl) inProgressEl.classList.add('hidden');
        if (completeEl) completeEl.classList.remove('hidden');
        return;
      }

      const countEl = document.getElementById('progress-count');
      const barEl = document.getElementById('progress-bar');
      const timeLeftEl = document.getElementById('progress-time-left');
      if (countEl) countEl.textContent = String(count);
      if (barEl) barEl.style.width = Math.min(100, (count / total) * 100) + '%';

      if (timeLeftEl) {
        const visitedSet = new Set(visited);
        const minutesLeft = pageMinutes.reduce((sum, p) => {
          return visitedSet.has(p.id) ? sum : sum + p.readMinutes;
        }, 0);
        timeLeftEl.textContent = minutesLeft > 0 ? ` About ${minutesLeft} min left.` : '';
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', render);
    } else {
      render();
    }
  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Tldr from '../../components/Tldr.astro';
import TryItNow from '../../components/TryItNow.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import CopyPrompt from '../../components/CopyPrompt.astro';
import Callout from '../../components/Callout.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import Quote from '../../components/Quote.astro';
import GlossaryLink from '../../components/GlossaryLink.astro';
import { href } from '../../lib/site';
---
<BaseLayout
  title="Getting Started"
  description="Get logged in and running with Claude in about five minutes."
  pageId="getting-started"
  readMinutes={5}
>
  <PageHeader
    icon="🚀"
    title="Getting Started"
    subtitle="From zero to having a real conversation with Claude — in under ten minutes."
    readMinutes={5}
  />

  <Tldr>
    <p>
      Aptera provides Claude access to every employee. You can use it in a browser tab right now — no install needed. For more power, the desktop app adds connectors and automation. This page walks you through logging in, saying hello, and running your first useful task.
    </p>
  </Tldr>

  <Quote attribution="Ethan Mollick" source="Co-Intelligence: Living and Working with AI">
    "Always invite AI to the table."
  </Quote>

  <!-- Who to contact -->
  <section class="reveal prose-content mb-10">
    <h2>Need help getting access?</h2>
    <p>
      Two people can sort you out fast:
    </p>
    <ul>
      <li><strong>Jake</strong> (<a href="mailto:jake@aptera.us">jake@aptera.us</a>) — questions about how we use Claude, what's allowed, or what any of this even means.</li>
      <li><strong>IT</strong> — can't log in, need a seat added, desktop app won't install. IT has the keys.</li>
    </ul>
    <p>When in doubt, start with Jake. He likes this stuff.</p>
  </section>

  <!-- Three ways in -->
  <section class="reveal mb-10">
    <h2 class="mb-4 text-2xl font-bold tracking-tight">The three ways in</h2>
    <p class="mb-5 text-muted">Pick the one that fits where you are right now. You can always level up later.</p>

    <div class="grid gap-4 sm:grid-cols-3">
      <FeatureCard emoji="🌐" title="Browser (claude.ai)" accent="chat">
        <p>
          Log in with your Aptera account at <strong class="text-text">claude.ai</strong>. That's it. Works on any device, no install required. This is where most people start — and honestly, most people stay.
        </p>
      </FeatureCard>
      <FeatureCard emoji="🖥️" title="Desktop App" accent="cowork">
        <p>
          Download from <strong class="text-text">claude.ai/download</strong>. Unlocks connectors (plug Claude into Jira, SharePoint, Outlook), Co-Work mode, and Schedules for recurring tasks. The upgrade worth making.
        </p>
      </FeatureCard>
      <FeatureCard emoji="💻" title="Claude Code" accent="code">
        <p>
          A terminal tool for technical folks — engineers, data analysts, anyone comfortable with a command line. IT can help install it. Skip this one if that sentence made your eye twitch.
        </p>
      </FeatureCard>
    </div>

    <Callout variant="chat" title="Terminal-shy? No problem.">
      <p>
        Claude Code is 100% optional. The browser and desktop app are the complete experience for most roles — if the word "terminal" makes your eye twitch, skip it guilt-free.
      </p>
    </Callout>
  </section>

  <!-- First 10 minutes -->
  <section class="reveal prose-content mb-10">
    <h2>Your first 10 minutes</h2>
    <p>Do this right now. It'll take less time than your next Slack scroll.</p>

    <ol class="space-y-4 pl-0" style="list-style: none; counter-reset: steps;">
      <li class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold font-bold text-canvas text-sm">1</span>
        <div>
          <strong class="text-text">Log in at claude.ai</strong>
          <p class="mt-1 text-muted">Use your Aptera email. If you hit a paywall or "no access" screen, ping Jake or IT.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold font-bold text-canvas text-sm">2</span>
        <div>
          <strong class="text-text">Say hello</strong>
          <p class="mt-1 text-muted">Type "Hi, I work at Aptera Motors. What can you help me with today?" Watch it respond like a smart colleague who's been briefed on the job.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold font-bold text-canvas text-sm">3</span>
        <div>
          <strong class="text-text">Ask it to rewrite an email</strong>
          <p class="mt-1 text-muted">Copy a recent email you sent — something you wished landed better — and ask Claude to punch it up. You'll immediately see what it's good at.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold font-bold text-canvas text-sm">4</span>
        <div>
          <strong class="text-text">Notice the <GlossaryLink term="artifact">Artifact</GlossaryLink> panel</strong>
          <p class="mt-1 text-muted">When Claude produces a document, table, or longer piece of content, it opens in a side panel. You can copy, download, or keep editing right there. That panel is your deliverable.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold font-bold text-canvas text-sm">5</span>
        <div>
          <strong class="text-text">Try a follow-up</strong>
          <p class="mt-1 text-muted">Reply in the same conversation: "Make it shorter" or "Add a friendlier sign-off." Iteration is the whole game. The first answer is a draft. The third answer is usually great.</p>
        </div>
      </li>
    </ol>
  </section>

  <Callout variant="gold" title="🔒 Keep it clean">
    <p>
      Don't paste passwords, API keys, customer PII, or anything you wouldn't put in a Slack message to the whole company. Claude is powerful — but your judgment about what to share is still the first line of defense. Not sure? Check the <a href={href('/safety/')} class="font-semibold underline underline-offset-2">Safety &amp; Data page</a>.
    </p>
  </Callout>

  <TryItNow title="Starter prompts — copy and go">
    <p>Paste either of these into Claude right now to feel what it's like:</p>
    <CopyPrompt text="Rewrite this email to be friendlier but still firm. Keep it under 150 words. Here's the original: [paste your email]" />
    <CopyPrompt text="I'm new to using AI at work. Ask me three questions to figure out which tasks I should try delegating to you first." />
  </TryItNow>

  <KeyTakeaways>
    <ul>
      <li>You can start in the browser <em>right now</em> — log in with your Aptera account at claude.ai, no install needed.</li>
      <li>The desktop app is the real power move: connectors, Co-Work, and Schedules live there.</li>
      <li>Iteration is the superpower — treat every first answer as a rough draft, then push back until it's right.</li>
    </ul>
  </KeyTakeaways>
</BaseLayout>

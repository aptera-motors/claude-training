---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';

const glossaryItems = await getCollection('glossary');
// Sort by term alphabetically
const sorted = glossaryItems.sort((a, b) => a.data.term.localeCompare(b.data.term));
const rendered = await Promise.all(
  sorted.map(async (item) => ({ id: item.id, data: item.data, Content: (await render(item)).Content }))
);

// Group by letter and get unique letters
const grouped = rendered.reduce(
  (acc, item) => {
    const letter = item.data.letter.toUpperCase();
    if (!acc[letter]) acc[letter] = [];
    acc[letter].push(item);
    return acc;
  },
  {} as Record<string, typeof rendered>
);

const letters = Object.keys(grouped).sort();
---
<BaseLayout
  title="Glossary"
  description="Plain-English definitions for all the AI jargon."
  pageId="glossary"
  readMinutes={4}
>
  <PageHeader
    icon="📖"
    title="Glossary"
    subtitle="Plain-English definitions for all the AI jargon."
    readMinutes={4}
  />

  <!-- Letter jump nav -->
  <nav class="mb-8 flex flex-wrap gap-2">
    {
      letters.map((letter) => (
        <a
          href={`#letter-${letter}`}
          class="rounded-full border border-border bg-card px-3 py-1.5 text-sm font-medium text-text transition-colors hover:border-gold/50 hover:bg-card-hover hover:text-gold"
        >
          {letter}
        </a>
      ))
    }
  </nav>

  <!-- Terms grouped by letter -->
  <div class="space-y-10">
    {
      letters.map((letter) => (
        <section id={`letter-${letter}`}>
          <h2 class="mb-5 text-2xl font-bold text-text">{letter}</h2>
          <div class="space-y-4">
            {
              grouped[letter].map(({ id, data, Content }) => (
                <div class="scroll-mt-20 rounded-[12px] border border-border bg-card p-4 hover:border-gold/50 hover:bg-card-hover" id={id}>
                  <h3 class="font-bold text-gold">{data.term}</h3>
                  <div class="prose-content mt-2 text-muted [&_p]:m-0 [&_p+p]:mt-2">
                    <Content />
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

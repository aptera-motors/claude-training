---
import '../styles/global.css';
import { NAV_GROUPS, PAGE_ORDER, prevNext, href, PROGRESS_KEY } from '../lib/site';

interface Props {
  title: string;
  description: string;
  pageId: string;
}
const { title, description, pageId } = Astro.props;
const { prev, next } = prevNext(pageId);
const pagefindBase = href('/pagefind/');

// Social / canonical metadata
const fullTitle = `${title} · Aptera AI Academy`;
const me = PAGE_ORDER.find((p) => p.id === pageId);
const canonical = new URL(href(me?.href ?? '/'), Astro.site).href;
const ogImage = new URL(href('/og.png'), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Aptera AI Academy</title>
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aptera AI Academy" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><circle cx='8' cy='8' r='6' fill='%23F5C518'/></svg>" />
    <link href={`${pagefindBase}pagefind-ui.css`} rel="stylesheet" />

    <!-- Pre-paint theme resolution: avoid flash of wrong theme -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('aptera-theme');
          var theme = stored === 'light' || stored === 'dark'
            ? stored
            : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-text">
    <a
      href="#main"
      class="fixed left-2 top-2 z-[60] -translate-y-16 rounded-[12px] border border-gold bg-card px-4 py-2 text-sm font-semibold text-gold opacity-0 transition-all focus:translate-y-0 focus:opacity-100"
    >
      Skip to content
    </a>
    <!-- Mobile top bar -->
    <div
      class="sticky top-0 z-40 flex items-center justify-between border-b border-border bg-canvas/95 px-4 py-3 backdrop-blur lg:hidden"
    >
      <a href={href('/')} class="flex items-center gap-2 font-bold">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-gold" style="box-shadow: 0 0 8px 2px color-mix(in srgb, var(--color-gold-bright) 60%, transparent)"></span>
        Aptera AI Academy
      </a>
      <div class="flex items-center gap-2">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Switch to light theme"
          class="rounded-lg border border-border px-3 py-1.5 text-text"
        >
          <span id="theme-toggle-icon" aria-hidden="true">☀️</span>
        </button>
        <button
          id="nav-toggle"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          class="rounded-lg border border-border px-3 py-1.5 text-text"
        >
          ☰
        </button>
      </div>
    </div>

    <div class="mx-auto flex w-full max-w-[1400px]">
      <!-- Sidebar -->
      <aside
        id="sidebar"
        class="fixed inset-y-0 left-0 z-50 hidden w-72 -translate-x-full flex-col overflow-y-auto border-r border-border bg-card px-5 py-6 transition-transform lg:sticky lg:top-0 lg:flex lg:h-screen lg:translate-x-0"
      >
        <div class="mb-6 flex items-center justify-between">
          <a href={href('/')} class="flex items-center gap-2.5 text-lg font-extrabold tracking-tight">
            <span class="inline-block h-3 w-3 rounded-full bg-gold" style="box-shadow: 0 0 10px 2px color-mix(in srgb, var(--color-gold-bright) 60%, transparent)"></span>
            Aptera AI Academy
          </a>
          <div class="flex items-center gap-2">
            <button
              id="theme-toggle-desktop"
              type="button"
              aria-label="Switch to light theme"
              class="hidden rounded-lg border border-border px-2 py-1 text-muted lg:inline-flex"
            >
              <span id="theme-toggle-desktop-icon" aria-hidden="true">☀️</span>
            </button>
            <button
              id="nav-close"
              type="button"
              aria-label="Close navigation"
              class="rounded-lg border border-border px-2 py-1 text-muted lg:hidden"
            >
              ✕
            </button>
          </div>
        </div>

        <!-- Search (ordered first on mobile so it's visible near the top of the drawer) -->
        <div class="order-first mb-6 border-b border-border pb-4 lg:order-none lg:mb-6 lg:border-b lg:pb-4">
          <p class="mb-2 px-2 text-xs font-bold uppercase tracking-widest text-dim">Search</p>
          <div id="search"></div>
          <p id="search-fallback" class="hidden px-2 text-xs text-dim">
            Search works after the site is built.
          </p>
        </div>

        <nav class="flex-1 space-y-6 text-[0.95rem]">
          {
            NAV_GROUPS.map((group) => (
              <div>
                <p class="mb-2 px-2 text-xs font-bold uppercase tracking-widest text-dim">
                  {group.title}
                </p>
                <ul class="space-y-0.5">
                  {group.pages.map((page) => (
                    <li>
                      <a
                        href={href(page.href)}
                        data-pageid={page.id}
                        class:list={[
                          'nav-link group flex items-center gap-2 rounded-lg px-2.5 py-1.5 transition-colors hover:bg-card-hover',
                          page.id === pageId
                            ? 'bg-card-hover font-semibold text-gold'
                            : 'text-muted hover:text-text',
                        ]}
                      >
                        <span class="text-base">{page.emoji}</span>
                        <span class="flex-1">{page.label}</span>
                        <span class="nav-check hidden text-gold" aria-hidden="true">✓</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <!-- Backdrop for mobile drawer -->
      <div id="nav-backdrop" class="fixed inset-0 z-40 hidden bg-black/60 lg:hidden"></div>

      <!-- Main content -->
      <main id="main" class="min-w-0 flex-1 px-5 py-8 sm:px-8 lg:px-12 lg:py-12">
        <div class="mx-auto w-full max-w-[760px]">
          <div data-pagefind-body>
            <slot />
          </div>

          <!-- Prev / Next -->
          {
            (prev || next) && (
              <nav class="mt-14 grid gap-3 border-t border-border pt-8 sm:grid-cols-2">
                {prev ? (
                  <a
                    href={href(prev.href)}
                    class="hover-lift rounded-[12px] border border-border bg-card px-4 py-3 transition-colors hover:border-gold/50 hover:bg-card-hover"
                  >
                    <span class="block text-xs text-dim">← Previous</span>
                    <span class="block font-semibold text-text">{prev.emoji} {prev.label}</span>
                  </a>
                ) : (
                  <span />
                )}
                {next ? (
                  <a
                    href={href(next.href)}
                    class="hover-lift rounded-[12px] border border-border bg-card px-4 py-3 text-right transition-colors hover:border-gold/50 hover:bg-card-hover sm:col-start-2"
                  >
                    <span class="block text-xs text-dim">Next →</span>
                    <span class="block font-semibold text-text">{next.label} {next.emoji}</span>
                  </a>
                ) : null}
              </nav>
            )
          }

          <footer class="mt-12 border-t border-border pt-6 text-center text-xs text-dim">
            Aptera AI Academy · Built for the crew that builds the sun-powered future.
          </footer>
        </div>
      </main>
    </div>

    <!-- Progress tracking + nav drawer -->
    <script define:vars={{ pageId, progressKey: PROGRESS_KEY }}>
      // ---- Progress tracking ----
      function readProgress() {
        try {
          const raw = localStorage.getItem(progressKey);
          const arr = raw ? JSON.parse(raw) : [];
          return Array.isArray(arr) ? arr : [];
        } catch {
          return [];
        }
      }
      function writeProgress(arr) {
        try {
          localStorage.setItem(progressKey, JSON.stringify(arr));
        } catch {
          /* ignore */
        }
      }
      // Record this page visit.
      const visited = readProgress();
      if (pageId && !visited.includes(pageId)) {
        visited.push(pageId);
        writeProgress(visited);
      }
      // Mark visited pages in the sidebar with a gold check.
      const current = readProgress();
      document.querySelectorAll('.nav-link').forEach((link) => {
        const id = link.getAttribute('data-pageid');
        if (id && current.includes(id)) {
          const check = link.querySelector('.nav-check');
          if (check) check.classList.remove('hidden');
        }
      });
      // Expose a tiny helper for other scripts/pages.
      window.apteraProgress = {
        key: progressKey,
        get: readProgress,
        count: () => readProgress().length,
        has: (id) => readProgress().includes(id),
      };

      // ---- Sidebar: scroll active link into view ----
      const activeLink = document.querySelector('.nav-link[data-pageid="' + pageId + '"]');
      activeLink?.scrollIntoView({ block: 'nearest' });

      // ---- Mobile nav drawer ----
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('nav-backdrop');
      const navToggle = document.getElementById('nav-toggle');
      function openNav() {
        sidebar?.classList.remove('hidden', '-translate-x-full');
        sidebar?.classList.add('flex');
        backdrop?.classList.remove('hidden');
        navToggle?.setAttribute('aria-expanded', 'true');
        const focusable = sidebar?.querySelector('a, button, [tabindex]');
        if (focusable instanceof HTMLElement) focusable.focus();
      }
      function closeNav() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
        if (window.innerWidth < 1024) sidebar?.classList.remove('flex');
        navToggle?.setAttribute('aria-expanded', 'false');
        if (navToggle instanceof HTMLElement) navToggle.focus();
      }
      function isNavOpen() {
        return !!sidebar && !sidebar.classList.contains('hidden') && !sidebar.classList.contains('-translate-x-full');
      }
      navToggle?.addEventListener('click', openNav);
      document.getElementById('nav-close')?.addEventListener('click', closeNav);
      backdrop?.addEventListener('click', closeNav);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isNavOpen() && window.innerWidth < 1024) closeNav();
      });

      // ---- Theme toggle ----
      const THEME_KEY = 'aptera-theme';
      const root = document.documentElement;
      const toggleButtons = [
        { btn: document.getElementById('theme-toggle'), icon: document.getElementById('theme-toggle-icon') },
        { btn: document.getElementById('theme-toggle-desktop'), icon: document.getElementById('theme-toggle-desktop-icon') },
      ];
      function syncThemeUI() {
        const theme = root.dataset.theme === 'light' ? 'light' : 'dark';
        const nextLabel = theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
        const icon = theme === 'dark' ? '☀️' : '🌙';
        toggleButtons.forEach(({ btn, icon: iconEl }) => {
          if (btn) btn.setAttribute('aria-label', nextLabel);
          if (iconEl) iconEl.textContent = icon;
        });
      }
      function setTheme(theme, persist) {
        root.dataset.theme = theme;
        if (persist) {
          try {
            localStorage.setItem(THEME_KEY, theme);
          } catch {
            /* ignore */
          }
        }
        syncThemeUI();
      }
      function hasStoredTheme() {
        try {
          const stored = localStorage.getItem(THEME_KEY);
          return stored === 'light' || stored === 'dark';
        } catch {
          return false;
        }
      }
      toggleButtons.forEach(({ btn }) => {
        btn?.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          setTheme(next, true);
        });
      });
      const colorSchemeQuery = window.matchMedia('(prefers-color-scheme: light)');
      colorSchemeQuery.addEventListener('change', (e) => {
        if (!hasStoredTheme()) setTheme(e.matches ? 'light' : 'dark', false);
      });
      syncThemeUI();

      // ---- Scroll reveal (progressive enhancement) ----
      // CSS only hides .reveal under html.reveal-ready, so content is never
      // hidden unless this script is running and motion is wanted.
      const revealEls = document.querySelectorAll('.reveal');
      if (
        revealEls.length &&
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('reveal-ready');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        revealEls.forEach((el) => {
          // Anything already in the viewport shows immediately — no waiting
          // on observer timing for above-the-fold content.
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight && r.bottom > 0) {
            el.classList.add('is-visible');
          } else {
            observer.observe(el);
          }
        });
      }
    </script>

    <!-- Pagefind UI: only present after build. Degrade gracefully in dev. -->
    <script define:vars={{ pagefindBase }}>
      (function () {
        const mount = document.getElementById('search');
        const fallback = document.getElementById('search-fallback');
        const js = pagefindBase + 'pagefind-ui.js';
        const probe = document.createElement('script');
        probe.type = 'module';
        probe.src = js;
        probe.onload = () => {
          try {
            // PagefindUI is registered as a global by the UI bundle.
            new window.PagefindUI({ element: '#search', showSubResults: true, resetStyles: false });
          } catch {
            if (fallback) fallback.classList.remove('hidden');
          }
        };
        probe.onerror = () => {
          if (fallback) fallback.classList.remove('hidden');
        };
        document.head.appendChild(probe);
      })();
    </script>
  </body>
</html>
